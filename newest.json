[{"short_id":"lz6eoe","created_at":"2026-07-27T18:07:19.046-05:00","title":"Apple MIE exploitation challenge","url":"https://blog.calif.io/p/apple-mie-exploitation-challenge","score":2,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"fro","user_is_author":false,"tags":["mac","security"],"short_id_url":"https://lobste.rs/s/lz6eoe","comments_url":"https://lobste.rs/s/lz6eoe/apple_mie_exploitation_challenge"},{"short_id":"nfcclq","created_at":"2026-07-27T17:27:54.251-05:00","title":"Setup a Simple, Self-Hosted Web Server with OpenBSD","url":"https://btxx.org/posts/self-hosted-openbsd/","score":2,"flags":0,"comment_count":2,"description":"","description_plain":"","submitter_user":"bt","user_is_author":true,"tags":["openbsd","web"],"short_id_url":"https://lobste.rs/s/nfcclq","comments_url":"https://lobste.rs/s/nfcclq/setup_simple_self_hosted_web_server_with"},{"short_id":"ui6l8e","created_at":"2026-07-27T17:20:22.654-05:00","title":"Usability, Community, and LLMs' Von Neumann Bottleneck","url":"https://sequentialread.com/usability-and-llms-ram-bottleneck/","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"forestj","user_is_author":true,"tags":["a11y","culture","vibecoding"],"short_id_url":"https://lobste.rs/s/ui6l8e","comments_url":"https://lobste.rs/s/ui6l8e/usability_community_llms_von_neumann"},{"short_id":"k0fp6p","created_at":"2026-07-27T16:35:55.618-05:00","title":"The Pad-O-Matic prints one-time pads at the press of a button","url":"https://spectrum.ieee.org/diy-one-time-pad-machine","score":2,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"connorboyle","user_is_author":false,"tags":["cryptography","hardware"],"short_id_url":"https://lobste.rs/s/k0fp6p","comments_url":"https://lobste.rs/s/k0fp6p/pad_o_matic_prints_one_time_pads_at_press"},{"short_id":"huyvjd","created_at":"2026-07-27T15:30:01.674-05:00","title":"How to Deal with 1,000 Failing Specs in a Rails App (2019)","url":"https://blog.planetargon.com/blog/entries/how-to-deal-with-1000-failing-specs-in-a-rails-app","score":1,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"rebeca","user_is_author":false,"tags":["ruby","testing"],"short_id_url":"https://lobste.rs/s/huyvjd","comments_url":"https://lobste.rs/s/huyvjd/how_deal_with_1_000_failing_specs_rails_app"},{"short_id":"e0nmps","created_at":"2026-07-27T15:10:59.036-05:00","title":"Towards a Theory of Bugs: The Ruliology of the Unexpected","url":"https://writings.stephenwolfram.com/2026/07/towards-a-theory-of-bugs-the-ruliology-of-the-unexpected/","score":2,"flags":0,"comment_count":1,"description":"\u003cp\u003eWolfram uses his own notation for TMs here, which I figured out by looking at this page of ANKS: \u003ca href=\"https://www.wolframscience.com/nks/p78--turing-machines/\" rel=\"ugc\"\u003ehttps://www.wolframscience.com/nks/p78--turing-machines/\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eIt's basically a cellular-automata-ized TM where the read/write head has one of three possible states (represented by arrow up, arrow to bottom right, and arrow to bottom left). The head states don't correspond to any semantic notion like \"about to write\" or \"about to move left/right\" as far as I can tell, they're just a way of encoding an extra trit of state information.\u003c/p\u003e\n\u003cp\u003eThen the state machine is defined as a pattern-match over the current head/cell state, with some rules mapping to the subsequent head/cell state.\u003c/p\u003e\n\u003cp\u003eThen the final thing is the diagrams showing the automata progressing over time. Each row growing downward is one additional step.\u003c/p\u003e\n","description_plain":"Wolfram uses his own notation for TMs here, which I figured out by looking at this page of ANKS: https://www.wolframscience.com/nks/p78--turing-machines/\r\n\r\nIt's basically a cellular-automata-ized TM where the read/write head has one of three possible states (represented by arrow up, arrow to bottom right, and arrow to bottom left). The head states don't correspond to any semantic notion like \"about to write\" or \"about to move left/right\" as far as I can tell, they're just a way of encoding an extra trit of state information.\r\n\r\nThen the state machine is defined as a pattern-match over the current head/cell state, with some rules mapping to the subsequent head/cell state.\r\n\r\nThen the final thing is the diagrams showing the automata progressing over time. Each row growing downward is one additional step.","submitter_user":"ahelwer","user_is_author":false,"tags":["math"],"short_id_url":"https://lobste.rs/s/e0nmps","comments_url":"https://lobste.rs/s/e0nmps/towards_theory_bugs_ruliology"},{"short_id":"snetpk","created_at":"2026-07-27T13:57:58.591-05:00","title":"Seriously, what is the large code-model even for?","url":"https://fzakaria.com/2026/07/26/seriously-what-is-the-large-code-model-even-for","score":6,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"alurm","user_is_author":false,"tags":["assembly","compilers"],"short_id_url":"https://lobste.rs/s/snetpk","comments_url":"https://lobste.rs/s/snetpk/seriously_what_is_large_code_model_even"},{"short_id":"vptzoz","created_at":"2026-07-27T13:35:17.693-05:00","title":"The Unreasonable Effectiveness of Constructive Data Modeling","url":"https://www.youtube.com/watch?v=0BXuYlNrUmE","score":5,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"nemin","user_is_author":false,"tags":["plt","video"],"short_id_url":"https://lobste.rs/s/vptzoz","comments_url":"https://lobste.rs/s/vptzoz/unreasonable_effectiveness"},{"short_id":"pngdot","created_at":"2026-07-27T12:40:23.753-05:00","title":"Advantages and disadvantages of Windows NT 3.1","url":"https://dfarq.homeip.net/advantages-and-disadvantages-of-windows-nt-3-1/","score":11,"flags":0,"comment_count":0,"description":"","descri