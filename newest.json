[{"short_id":"fl7dcm","created_at":"2026-08-10T12:31:01.068-05:00","title":"Gtk+Adwaita Markdown Editor in ~600 lines","url":"https://gist.github.com/aziis98/368b40d6cae01f8d40a6e3d2cccd4c31","score":2,"flags":0,"comment_count":0,"description":"\u003cp\u003eIf you need a small self contained split view markdown editor (uses a gtk webview, requires an internet for marked.js+katex from a cdn) in GTK+Adwaita.\u003c/p\u003e\n\u003cp\u003eBy the way I know about \u003ca href=\"https://gitlab.gnome.org/World/apostrophe\" rel=\"ugc\"\u003eApostrophe\u003c/a\u003e and actually it was the main inspiration for this. I am working on a larger GTK app and I want more software with decent Markdown rendering. This gist is just a small self contained prototype to show off that building this kind of app has become fairly easy today.\u003c/p\u003e\n","description_plain":"If you need a small self contained split view markdown editor (uses a gtk webview, requires an internet for marked.js+katex from a cdn) in GTK+Adwaita.\r\n\r\nBy the way I know about [Apostrophe](https://gitlab.gnome.org/World/apostrophe) and actually it was the main inspiration for this. I am working on a larger GTK app and I want more software with decent Markdown rendering. This gist is just a small self contained prototype to show off that building this kind of app has become fairly easy today.","submitter_user":"aziis98","user_is_author":true,"tags":["python","show","vibecoding"],"short_id_url":"https://lobste.rs/s/fl7dcm","comments_url":"https://lobste.rs/s/fl7dcm/gtk_adwaita_markdown_editor_600_lines"},{"short_id":"exgfc0","created_at":"2026-08-10T11:47:33.710-05:00","title":"A researcher bought noreply.net. Companies started sending him secrets","url":"https://arstechnica.com/security/2026/08/a-researcher-bought-noreply-net-companies-started-sending-him-secrets/","score":4,"flags":0,"comment_count":0,"description":"","description_plain":"","submitter_user":"hoistbypetard","user_is_author":false,"tags":["priva